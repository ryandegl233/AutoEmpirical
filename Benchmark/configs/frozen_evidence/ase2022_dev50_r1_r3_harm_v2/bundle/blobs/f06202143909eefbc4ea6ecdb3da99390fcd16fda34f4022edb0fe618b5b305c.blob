{"canonical_uri":"https://github.com/tensorflow/tfjs/blob/ed94a27288385f3babbc9a399e13cbbe29bbddaa/tfjs/package.json","patch":"@@ -59,8 +59,6 @@\n     \"bundle\": \"rollup -c\",\n     \"bundle-ci\": \"rollup -c --ci\",\n     \"build-link-package\": \"cd ../link-package && yarn build\",\n-    \"build-layers\": \"cd ../tfjs-layers && yarn && yarn build\",\n-    \"build-layers-ci\": \"cd ../tfjs-layers && yarn && yarn build-ci\",\n     \"build-data\": \"cd ../tfjs-data && yarn && yarn build\",\n     \"build-data-ci\": \"cd ../tfjs-data && yarn && yarn build-ci\",\n     \"build-deps\": \"yarn build-link-package && yarn build-layers && yarn build-data\",\n@@ -84,7 +82,7 @@\n     \"@tensorflow/tfjs-converter\": \"link:../link-package/node_modules/@tensorflow/tfjs-converter\",\n     \"@tensorflow/tfjs-core\": \"link:../link-package/node_modules/@tensorflow/tfjs-core\",\n     \"@tensorflow/tfjs-data\": \"link:../tfjs-data\",\n-    \"@tensorflow/tfjs-layers\": \"link:../tfjs-layers\",\n+    \"@tensorflow/tfjs-layers\": \"link:../link-package/node_modules/@tensorflow/tfjs-layers\",\n     \"argparse\": \"^1.0.10\",\n     \"chalk\": \"^4.1.0\",\n     \"core-js\": \"3\",","repository":"tensorflow/tfjs","updated_at":"2021-10-04T02:17:29Z"}